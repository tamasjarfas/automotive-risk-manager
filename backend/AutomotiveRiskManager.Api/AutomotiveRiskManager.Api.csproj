<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- A projekt neve és leírása -->
    <AssemblyName>AutomotiveRiskManager.Api</AssemblyName>
    <RootNamespace>AutomotiveRiskManager.Api</RootNamespace>
    <!-- .NET User Secrets azonosító: a helyi, Gitbe nem kerülő titkok (pl. DB-jelszó) tárolásához -->
    <UserSecretsId>8f3c2a71-5d4e-4b9a-a1c6-2e7b9d0f4a35</UserSecretsId>
  </PropertyGroup>

  <!-- ─── Adatbázis-kezelés ──────────────────────────────────────────────────
       EF Core 10: az .NET SDK-val azonos major verzió, garantáltan kompatibilis.
       Npgsql 9.x: a PostgreSQL .NET driver; .NET 8+ célzású, .NET 10-en fut.
       Microsoft.EntityFrameworkCore.Design: csak fordítási eszköz (migrációhoz),
         PrivateAssets="all" → nem kerül a végleges binárisba. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- ASP.NET Core Identity: felhasználók, szerepkörök, jelszókivonat, EF Core tárolás.
         Az EF Core csomagokkal azonos 10.0.4 verzió. -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.4" />
  </ItemGroup>

  <!-- ─── Swagger/OpenAPI ────────────────────────────────────────────────────
       Ideiglenesen eltávolítva: Swashbuckle 6.x és Microsoft.AspNetCore.OpenApi 10.x
       inkompatibilis Microsoft.OpenApi verziókat húznak be (CS7069 + NU1903).
       Visszavezetés: következő kompatibilis Swashbuckle kiadáskor. -->

</Project>

